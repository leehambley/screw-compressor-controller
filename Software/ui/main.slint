// 800x480 operator screen. Same content as the old Nextion page 0:
// pressure, setpoint -/+, motor speed and power, a motor note, a status
// bar, the RUN/STOP/RESET button and the two hold-to-act buttons.
// All text and colours come from Rust (src/ui.rs); this file is layout only.

component Btn inherits Rectangle {
    in property <string> label;
    in property <color> bg: #3a3a3a;
    in property <color> fg: white;
    in property <length> font: 28px;
    callback pressed();
    callback released();
    border-radius: 10px;
    background: touch.pressed ? bg.darker(30%) : bg;
    Text {
        text: root.label;
        color: root.fg;
        font-size: root.font;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.pressed(); }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.released(); }
        }
    }
}

component Readout inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> unit;
    in property <color> fg: white;
    in property <length> big: 72px;
    background: #1c1c1c;
    border-radius: 10px;
    VerticalLayout {
        padding: 12px;
        Text { text: root.title; color: #9a9a9a; font-size: 20px; }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Text { text: root.value; color: root.fg; font-size: root.big; font-weight: 700; vertical-alignment: bottom; }
            Text { text: root.unit; color: #9a9a9a; font-size: 26px; vertical-alignment: bottom; }
        }
    }
}

export component MainWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #000000;

    in property <string> pressure: "--";
    in property <color> pressure-fg: white;
    in property <string> setpoint: "--";
    in property <string> rpm: "--";
    in property <string> kw: "--";
    in property <color> motor-fg: white;
    in property <string> note;
    in property <color> note-fg: white;
    in property <string> status: "Starting up";
    in property <color> status-bg: #404040;
    in property <color> status-fg: white;
    in property <string> run-label: "START";
    in property <color> run-bg: #006400;
    in property <color> run-fg: white;

    callback run-pressed();
    callback setpoint-up();
    callback setpoint-down();
    callback unload(bool);
    callback purge(bool);

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            Readout { title: "Pressure"; value: root.pressure; unit: "bar"; fg: root.pressure-fg; big: 110px; horizontal-stretch: 3; }
            VerticalLayout {
                horizontal-stretch: 2;
                spacing: 10px;
                Readout { title: "Setpoint"; value: root.setpoint; unit: "bar"; big: 56px; }
                HorizontalLayout {
                    spacing: 10px;
                    height: 70px;
                    Btn { label: "-"; font: 44px; pressed => { root.setpoint-down(); } }
                    Btn { label: "+"; font: 44px; pressed => { root.setpoint-up(); } }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 110px;
            Readout { title: "Motor"; value: root.rpm; unit: "rpm"; fg: root.motor-fg; big: 52px; }
            Readout { title: "Power (est.)"; value: root.kw; unit: "kW"; fg: root.motor-fg; big: 52px; }
        }

        Text { text: root.note; color: root.note-fg; font-size: 22px; height: 28px; }

        Rectangle {
            height: 44px;
            background: root.status-bg;
            border-radius: 8px;
            Text { text: root.status; color: root.status-fg; font-size: 24px; vertical-alignment: center; horizontal-alignment: center; }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 80px;
            Btn { label: "UNLOAD"; pressed => { root.unload(true); } released => { root.unload(false); } }
            Btn { label: "PURGE"; pressed => { root.purge(true); } released => { root.purge(false); } }
            Btn { label: root.run-label; bg: root.run-bg; fg: root.run-fg; font: 34px; horizontal-stretch: 2; pressed => { root.run-pressed(); } }
        }
    }
}
