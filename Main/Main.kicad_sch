	(text "24V Rail supply regulated down to 5v \nfor use with the HMI display.\n\nThen the 5V input pin is used on the \nESP32 DevKit and the onboard LDO is \nused to regulate down to 3v3 for the \nMOSFETs and the MODBUS RS3485 IC."
		(exclude_from_sim no)
		(at 27.686 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4b985720-dc2c-4167-9a5d-f830ca7937ca")
	)
	(text "HMI DISPLAY\nNX8048P050-011R-Y\n  -- or --\nNX8048P050-011C-Y\n\nREQUIRES 5V@1A"
		(exclude_from_sim no)
		(at 93.472 99.314 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "70cd5d92-5e65-4d7a-8f8d-53e7b9a9be4c")
	)
	(text "POWER IN\nREGULATED 24VDC@~3.2A"
		(exclude_from_sim no)
		(at 43.688 49.784 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8b0662c4-fe14-4b89-b812-3be10128e347")
	)
	(text "SAKO SKI-70 VFD - MODBUS RTU REFERENCE\n========================================\nSerial: 9600 baud, 8N1, slave addr 1\nMax 5 registers per read request (HW limit)\nVFD Pd-params may reset on power-cycle - reverify after outage\n\nCONTROL\n  Control word......... reg 8193   1=run, 5=stop\n  Frequency setpoint.... reg 4097   value = Hz x 200\n\nMONITORING (base 28673)\n  Running frequency..... reg 28673      value / 100 = Hz\n  Output current........ reg 28674      value / 100 = A\n  Bus voltage............ reg 28675     value / 10  = V\n\nLIMITS (read at startup)\n  Min frequency (P0-12).. reg 61453\n  Max frequency (P0-14).. reg 61455\n\nVFD-side params confirmed:\n  P0-02 = 2   (comms command source)\n  P0-03 = 9   (comms frequency source)\n  Pd-00 = 5   (9600 baud)\n  Pd-01 = 3   (8N1)\n  Pd-02 = 1   (slave address 1)"
		(exclude_from_sim no)
		(at 17.018 168.91 0)
		(effects
			(font
				(face "PT Mono")
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b32a6c01-0b7b-4f4e-ab53-aba5ecd31222")
	)
	(text "PRESSURE TRANSDUCER\n12147851-type, 4-20mA, 24V"
		(exclude_from_sim no)
		(at 45.212 26.162 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f8d09aea-88da-4cdc-a30b-006ff4118ca2")
	)
	(text "COMPRESSOR MOTOR VFD\nSAKO SKI-70 VFD \nOR SIMILAR"
