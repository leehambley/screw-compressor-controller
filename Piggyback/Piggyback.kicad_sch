		(uuid "0563d49f-0159-499f-a640-bd9564cfc514")
	)
	(text "24 V in -> polyfuse -> series Schottky -> TVS = 24V_P;\nfeeds Waveshare VIN, valves and 4-20 mA loops."
		(exclude_from_sim no)
		(at 14 62 0)
		(effects
