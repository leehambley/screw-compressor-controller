	)
	(text "SAFE = WD_OK * TEMP_OK; V1/V2_DRV = PWM_Vn * SAFE; VFD_EN = SAFE."
		(exclude_from_sim no)
		(at 295 342 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1c3991fd-0e57-46c7-b6a9-5722148a7a2a")
	)
	(text "20 mA -> 2.0 V; <3.8 mA = open loop.\nAIN2 = 3V3_A/2 for ratiometric NTC maths, AIN3 = SAFE/2."
		(exclude_from_sim no)
		(at 14 226 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2514b108-04d6-40ae-a862-51847c1951a1")
	)
	(text "NTC 100k B~4000; shield to AGND at this end only.\nAIN0 rotor, AIN1 rotor 2, AIN2 motor, AIN3 TEMP_OK/2."
		(exclude_from_sim no)
		(at 210 228 0)
		(effects
